<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Strata comes from the folder pack-smoke.sh packs into, and from nowhere else; everything else from
       nuget.org. The packages are unpacked under obj/, so a re-packed version is never served from the
       machine-wide cache. -->
  <packageSources>
    <clear />
    <add key="strata-packed" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="strata-packed">
      <package pattern="Datalium.Strata" />
      <package pattern="Datalium.Strata.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="globalPackagesFolder" value="obj/packages" />
  </config>
</configuration>
