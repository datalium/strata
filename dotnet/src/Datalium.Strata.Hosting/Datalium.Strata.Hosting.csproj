<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Package.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Hosting for Datalium Strata: services.AddStrata(), settings from configuration, driver hosted services, long-term memory, health checks and OpenTelemetry wiring.</Description>
  </PropertyGroup>

  <!-- design/35-Hosting-Integration.md: the container, configuration, hosted services, health checks and
       OpenTelemetry wiring live here, so the engine, the stores and the AI package gain no dependency. OpenTelemetry is the
       API's provider-builder extensions only, not the SDK. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.19.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets without "analyzers": NuGet hides a dependency's analyzers from a package's own consumers
         by default, and the engine's source generator has to reach them
         (design/36-Packaging-And-Versioning.md). -->
    <ProjectReference Include="..\Datalium.Strata\Datalium.Strata.csproj" PrivateAssets="contentfiles;build" />
    <ProjectReference Include="..\Datalium.Strata.Storage\Datalium.Strata.Storage.csproj" PrivateAssets="contentfiles;build" />
    <ProjectReference Include="..\Datalium.Strata.Cloud\Datalium.Strata.Cloud.csproj" PrivateAssets="contentfiles;build" />
    <!-- The memory helper (design/45-Long-Term-Memory.md), so AddMemory() registers it. -->
    <ProjectReference Include="..\Datalium.Strata.AI\Datalium.Strata.AI.csproj" PrivateAssets="contentfiles;build" />
  </ItemGroup>

  <ItemGroup>
    <!-- The drivers' back-off and the probe thread id, for the tests that check them. -->
    <InternalsVisibleTo Include="Datalium.Strata.Tests" />
  </ItemGroup>

</Project>
