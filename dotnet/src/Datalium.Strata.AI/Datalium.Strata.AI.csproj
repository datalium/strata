<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Package.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Datalium.Strata.AI</RootNamespace>
    <Description>Model calls and agents for Datalium Strata: Microsoft.Extensions.AI's IChatClient from a node, streamed, observed and retried.</Description>
  </PropertyGroup>

  <!-- design/44-LLM-Integration.md: the model abstraction lives here, so it reaches only the hosts that call models.
       Microsoft.Extensions.AI's abstractions (any IChatClient works unchanged), System.ClientModel (the OpenAI and
       Azure SDKs' fault type, which the default classifier reads), and the engine: nothing else. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageReference Include="System.ClientModel" Version="1.15.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets without "analyzers": NuGet hides a dependency's analyzers from a package's own consumers
         by default, and the engine's source generator has to reach them
         (design/36-Packaging-And-Versioning.md). -->
    <ProjectReference Include="..\Datalium.Strata\Datalium.Strata.csproj" PrivateAssets="contentfiles;build" />
  </ItemGroup>

</Project>
