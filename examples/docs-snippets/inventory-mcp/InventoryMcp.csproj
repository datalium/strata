<Project Sdk="Microsoft.NET.Sdk">

  <!-- inventory-mcp: the small MCP server the samples for /guides/tools/mcp-servers/ connect to. The C# samples start
       it as a stdio child process, found on the PATH by its name, and serve InventoryServer.cs behind Kestrel for HTTP.
       The Rust samples have a twin, examples/docs-snippets/rust/examples/inventory-mcp/. Not a sample, and no MCP SDK. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>inventory-mcp</AssemblyName>
    <RootNamespace>Datalium.Strata.DocsSnippets.InventoryMcp</RootNamespace>
  </PropertyGroup>

</Project>
