{
  "ConnectionStrings": {
    "strata": "Host=localhost;Port=5432;Username=strata;Password=strata;Database=strata",
    "strata-redis": "localhost:6379"
  },
  "Strata": {
    "Sqlite": {
      "Path": "strata.db",
      "GroupCommit": { "Enabled": true, "MaxBatch": 256 },
      "Deltas": { "Enabled": true, "FullEvery": 16, "CachedThreads": 10000 },
      "Offload": { "Enabled": true, "Threshold": 65536, "Path": "blobs" }
    },
    "Postgres": {
      "ConnectionStringName": "strata",
      "AutoMigrate": false,
      "Retry": { "MaxAttempts": 4, "InitialDelay": "00:00:00.050", "MaxDelay": "00:00:02" },
      "GroupCommit": { "Enabled": true, "MaxBatch": 256, "MaxConcurrentFlushes": 4 },
      "Deltas": { "Enabled": true },
      "Offload": { "Enabled": true, "Threshold": 65536 }
    },
    "Redis": {
      "ConnectionStringName": "strata-redis",
      "Prefix": "orders",
      "FinishedThreadTtl": "7.00:00:00",
      "Retry": { "MaxAttempts": 4 },
      "Deltas": { "Enabled": false },
      "Offload": { "Enabled": false }
    },
    "Cloud": {
      "BaseUrl": "https://cloud.example.com",
      "ConnectTimeout": "00:00:03",
      "RequestTimeout": "00:00:30"
    },
    "Runs": {
      "Lease": { "Owner": "orders-1", "Ttl": "00:00:30" }
    },
    "Scheduler": {
      "MaxConcurrent": 16,
      "MaxQueued": 1024,
      "MaxQueueTime": "00:00:10",
      "Reservations": [ { "MinPriority": 5, "Slots": 2 } ],
      "TenantKey": "tenant",
      "TenantLimit": 4,
      "TenantLimits": { "acme": 8 }
    },
    "Wake": {
      "Interval": "00:00:05",
      "BatchSize": 100,
      "Metadata": { "app": "orders" },
      "MatchGraph": true,
      "Priority": 0
    },
    "Recovery": {
      "Interval": "00:00:30",
      "BatchSize": 100,
      "StaleAfter": "00:05:00",
      "MaxRecoveries": 3,
      "Priority": 10
    },
    "Retention": {
      "Interval": "01:00:00",
      "BatchSize": 1000,
      "OlderThan": "30.00:00:00",
      "States": [ "Completed", "Ended", "Failed" ]
    },
    "Memory": {
      "Dimensions": 1536,
      "Index": { "Kind": "Hnsw", "M": 16, "EfConstruction": 64 },
      "TenantKey": "tenant",
      "Retention": {
        "Interval": "01:00:00",
        "BatchSize": 1000,
        "OlderThan": "365.00:00:00",
        "Namespace": "incidents"
      }
    }
  }
}
