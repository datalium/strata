  "list": [
    {
      "name": "every thread, newest first, three to a page",
      "query": { "limit": 3 },
      "pages": [
        ["cancelled-nested", "resumed-acme", "approve-globex"],
        ["approve-acme-2", "approve-acme-1", "failed-acme"],
        ["nested-waiting", "completed-x", "ended-acme"],
        ["timer-initech", "event-globex", "event-forever"],
        ["timer-resumed", "nested-timer", "running-initech"]
      ]
    },
    {
      "name": "the waiting page: for a human, an event or a timer",
      "query": { "states": ["interrupted"], "limit": 2 },
      "pages": [
        ["approve-globex", "approve-acme-2"],
        ["approve-acme-1", "nested-waiting"],
        ["timer-initech", "event-globex"],
        ["event-forever", "nested-timer"]
      ]
    },
    {
      "name": "the recovery sweep: failed or cancelled",
      "query": { "states": ["failed", "cancelled"], "limit": 10 },
      "pages": [["cancelled-nested", "failed-acme"]]
    },
    {
      "name": "one tenant, any state",
      "query": { "metadata": { "tenant": "acme" }, "limit": 2 },
      "pages": [
        ["cancelled-nested", "resumed-acme"],
        ["approve-acme-2", "approve-acme-1"],
        ["failed-acme", "ended-acme"]
      ]
    },
    {
      "name": "every metadata pair must match",
      "query": { "states": ["interrupted"], "metadata": { "tenant": "acme", "incident": "INC-2" } },
      "pages": [["approve-acme-2"]]
    },
    {
      "name": "engine keys are filterable too",
      "query": { "metadata": { "error_kind": "transient" } },
      "pages": [["failed-acme"]]
    },
    {
      "name": "a time window is exclusive at both ends, and the cursor survives a same-second tie",
      "query": { "updated_after": "2026-10-01T09:00:00Z", "updated_before": "2026-10-01T12:00:00Z", "limit": 1 },
      "pages": [["resumed-acme"], ["approve-globex"], ["approve-acme-2"]]
    },
    {
      "name": "a resumed thread is not waiting any more",
      "query": { "states": ["resumed"] },
      "pages": [["resumed-acme", "timer-resumed"]]
    },
    {
      "name": "completed",
      "query": { "states": ["completed"] },
      "pages": [["completed-x"]]
    },
    {
      "name": "an ended thread is not waiting any more, and lists as ended",
      "query": { "states": ["ended"] },
      "pages": [["ended-acme"]]
    },
    {
      "name": "why and by whom a thread was ended are filterable",
      "query": { "metadata": { "strata.end_reason": "requested", "strata.ended_by": "oncall" } },
      "pages": [["ended-acme"]]
    },
    {
      "name": "due: a timer and a nested timer whose time has come, not a later timeout, a wait with none, or a resumed timer",
      "query": { "due_by": "2026-10-01T13:00:00Z" },
      "pages": [["timer-initech", "nested-timer"]]
    },
    {
      "name": "due later: the event wait's timeout too, two to a page",
      "query": { "due_by": "2026-10-01T14:00:00Z", "limit": 2 },
      "pages": [["timer-initech", "event-globex"], ["nested-timer"]]
    },
    {
      "name": "due, for one tenant",
      "query": { "due_by": "2026-10-01T14:00:00Z", "metadata": { "tenant": "globex" } },
      "pages": [["event-globex"]]
    },
    {
      "name": "nothing is due before the first wake time",
      "query": { "due_by": "2026-10-01T12:29:59Z" },
      "pages": [[]]
    },
    {
      "name": "one graph, any version",
      "query": { "graph_id": "billing" },
      "pages": [["approve-acme-2", "approve-acme-1", "failed-acme"]]
    },
    {
      "name": "one graph at one version, one to a page",
      "query": { "graph_id": "billing", "graph_version": "2", "limit": 1 },
      "pages": [["approve-acme-2"], ["failed-acme"]]
    },
    {
      "name": "a graph's waiting threads",
      "query": { "graph_id": "billing", "states": ["interrupted"] },
      "pages": [["approve-acme-2", "approve-acme-1"]]
    },
    {
      "name": "a nested thread is its outermost graph's",
      "query": { "graph_id": "incident" },
      "pages": [["nested-waiting"]]
    },
    {
      "name": "a nested level's graph is not the thread's",
      "query": { "graph_id": "approval" },
      "pages": [[]]
