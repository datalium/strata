{
  "description": "The memory store's shared cases (design/45-Long-Term-Memory.md, \"Semantics\"), replayed against every memory store in both engines: the in-memory and SQLite stores always, Postgres when STRATA_TEST_POSTGRES_URL is set, Redis when STRATA_TEST_REDIS_URL is set. Not a wire format: it pins search, filters, upserts, listing, purging and the refusals. Each case opens a fresh store of `dimensions` and runs `steps` in order. A step's `at` (RFC 3339) sets the store's clock first; it stays until another step sets it. A record in a step is the record's JSON form (schema/memory-record.schema.json) without `schema_version` and the timestamps, which the store sets; `tenant`, `content`, `text` and `metadata` default to \"\", null, null and {}. Steps: `upsert` (a record), `upsert_many` (records), `get` ({namespace, tenant, id}; `expect` the whole record with its timestamps and `schema_version` left out, or null), `delete` (a key; `expect` true or false), `search` ({namespace, tenant (default \"\"), vector, model, limit (default 10), min_similarity, exclude, metadata}; `expect` the matches in order as {id, similarity}, similarity compared to 1e-5), `list` ({namespace, tenant (default \"\"), metadata, limit (default 100)}; `expect_pages`: each page's ids, following the next cursor until there is none) and `purge` ({older_than, namespace, tenant, limit (default 1000)}; `expect` how many were deleted). A step with `error` must fail before anything is written, with exactly that message (.NET an ArgumentException with no parameter name; Rust a MemoryStoreError).",
  "cases": [
    {
      "name": "search ranks by similarity, most similar first, ties by id",
      "dimensions": 3,
      "steps": [
        {
          "at": "2026-10-01T00:00:00Z",
          "upsert_many": [
            { "namespace": "n", "id": "d", "embedding": { "model": "m", "vector": [-1, 0, 0] } },
            { "namespace": "n", "id": "b", "embedding": { "model": "m", "vector": [1, 1, 0] } },
            { "namespace": "n", "id": "e", "embedding": { "model": "m", "vector": [3, 0, 0] } },
            { "namespace": "n", "id": "c", "embedding": { "model": "m", "vector": [0, 1, 0] } },
            { "namespace": "n", "id": "f", "embedding": { "model": "m", "vector": [1, 0, 1] } },
            { "namespace": "n", "id": "a", "embedding": { "model": "m", "vector": [1, 0, 0] } }
          ]
        },
        {
          "search": { "namespace": "n", "vector": [1, 0, 0], "model": "m" },
          "expect": [
            { "id": "a", "similarity": 1 },
            { "id": "e", "similarity": 1 },
            { "id": "b", "similarity": 0.7071068 },
            { "id": "f", "similarity": 0.7071068 },
            { "id": "c", "similarity": 0 },
            { "id": "d", "similarity": -1 }
          ]
        },
        {
          "search": { "namespace": "n", "vector": [2, 0, 0], "model": "m", "limit": 3 },
          "expect": [
            { "id": "a", "similarity": 1 },
            { "id": "e", "similarity": 1 },
            { "id": "b", "similarity": 0.7071068 }
          ]
        },
        {
          "search": { "namespace": "n", "vector": [1, 0, 0], "model": "m", "min_similarity": 0.5 },
          "expect": [
            { "id": "a", "similarity": 1 },
            { "id": "e", "similarity": 1 },
            { "id": "b", "similarity": 0.7071068 },
            { "id": "f", "similarity": 0.7071068 }
          ]
        },
        {
          "search": { "namespace": "n", "vector": [1, 0, 0], "model": "m", "min_similarity": -0.5, "exclude": ["a", "e", "nobody"] },
          "expect": [
            { "id": "b", "similarity": 0.7071068 },
            { "id": "f", "similarity": 0.7071068 },
            { "id": "c", "similarity": 0 }
          ]
        },
        {
          "search": { "namespace": "n", "vector": [0, 1, 0], "model": "m", "limit": 2 },
          "expect": [
            { "id": "c", "similarity": 1 },
            { "id": "b", "similarity": 0.7071068 }
          ]
        }
      ]
    },
    {
      "name": "a search reads one namespace, one tenant and one model",
      "dimensions": 3,
      "steps": [
        {
          "at": "2026-10-01T00:00:00Z",
          "upsert_many": [
            { "namespace": "incidents", "id": "plain", "embedding": { "model": "m", "vector": [1, 0, 0] } },
            { "namespace": "incidents", "tenant": "acme", "id": "acme-1", "embedding": { "model": "m", "vector": [1, 0, 0] } },
            { "namespace": "incidents", "tenant": "globex", "id": "globex-1", "embedding": { "model": "m", "vector": [1, 0, 0] } },
            { "namespace": "incidents", "tenant": "acme", "id": "acme-other-model", "embedding": { "model": "m2", "vector": [1, 0, 0] } },
            { "namespace": "runbooks", "tenant": "acme", "id": "runbook-1", "embedding": { "model": "m", "vector": [1, 0, 0] } }
          ]
        },
        {
          "search": { "namespace": "incidents", "vector": [1, 0, 0], "model": "m" },
          "expect": [{ "id": "plain", "similarity": 1 }]
        },
        {
          "search": { "namespace": "incidents", "tenant": "acme", "vector": [1, 0, 0], "model": "m" },
          "expect": [{ "id": "acme-1", "similarity": 1 }]
        },
        {
          "search": { "namespace": "incidents", "tenant": "acme", "vector": [1, 0, 0], "model": "m2" },
          "expect": [{ "id": "acme-other-model", "similarity": 1 }]
        },
        {
          "search": { "namespace": "runbooks", "tenant": "acme", "vector": [1, 0, 0], "model": "m" },
          "expect": [{ "id": "runbook-1", "similarity": 1 }]
        },
        {
          "search": { "namespace": "facts", "tenant": "acme", "vector": [1, 0, 0], "model": "m" },
          "expect": []
        }
      ]
    },
    {
      "name": "metadata filters by equality on every pair given",
      "dimensions": 3,
      "steps": [
        {
          "at": "2026-10-01T00:00:00Z",
          "upsert_many": [
            { "namespace": "n", "id": "x1", "embedding": { "model": "m", "vector": [1, 0, 0] }, "metadata": { "service": "checkout-api", "zone": "eu" } },
            { "namespace": "n", "id": "x2", "embedding": { "model": "m", "vector": [1, 1, 0] }, "metadata": { "service": "checkout-api", "zone": "us" } },
            { "namespace": "n", "id": "y1", "embedding": { "model": "m", "vector": [1, 0, 0] }, "metadata": { "service": "payment-api" } },
            { "namespace": "n", "id": "z1", "embedding": { "model": "m", "vector": [1, 0, 0] } }
          ]
        },
        {
          "search": { "namespace": "n", "vector": [1, 0, 0], "model": "m", "metadata": { "service": "checkout-api" } },
          "expect": [
            { "id": "x1", "similarity": 1 },
            { "id": "x2", "similarity": 0.7071068 }
          ]
        },
        {
          "search": { "namespace": "n", "vector": [1, 0, 0], "model": "m", "metadata": { "service": "checkout-api", "zone": "us" } },
          "expect": [{ "id": "x2", "similarity": 0.7071068 }]
        },
        {
          "search": { "namespace": "n", "vector": [1, 0, 0], "model": "m", "metadata": { "zone": "ap" } },
          "expect": []
        },
        {
          "list": { "namespace": "n", "metadata": { "service": "checkout-api" } },
          "expect_pages": [["x1", "x2"]]
        }
      ]
    },
    {
      "name": "an upsert replaces a record and keeps when it was created",
      "dimensions": 3,
      "steps": [
        {
          "at": "2026-10-01T08:00:00Z",
          "upsert": {
            "namespace": "incidents",
            "tenant": "acme",
            "id": "i-1",
            "embedding": { "model": "m", "vector": [1, 0, 0] },
            "content": { "root_cause": "pool exhausted", "attempts": 1 },
            "text": "Alert: errors on checkout-api.",
            "metadata": { "service": "checkout-api" }
          }
        },
        {
          "get": { "namespace": "incidents", "tenant": "acme", "id": "i-1" },
          "expect": {
            "namespace": "incidents",
            "tenant": "acme",
            "id": "i-1",
            "embedding": { "model": "m", "vector": [1, 0, 0] },
            "content": { "root_cause": "pool exhausted", "attempts": 1 },
            "text": "Alert: errors on checkout-api.",
            "metadata": { "service": "checkout-api" },
            "created_at": "2026-10-01T08:00:00Z",
            "updated_at": "2026-10-01T08:00:00Z"
          }
        },
        {
          "at": "2026-10-02T09:30:00Z",
          "upsert": {
            "namespace": "incidents",
            "tenant": "acme",
            "id": "i-1",
            "embedding": { "model": "m", "vector": [0, 0.5, 0.25] },
            "content": { "root_cause": "a bad deploy" }
          }
        },
        {
          "get": { "namespace": "incidents", "tenant": "acme", "id": "i-1" },
          "expect": {
            "namespace": "incidents",
            "tenant": "acme",
            "id": "i-1",
            "embedding": { "model": "m", "vector": [0, 0.5, 0.25] },
            "content": { "root_cause": "a bad deploy" },
            "text": null,
            "metadata": {},
            "created_at": "2026-10-01T08:00:00Z",
            "updated_at": "2026-10-02T09:30:00Z"
          }
        },
        {
          "get": { "namespace": "incidents", "tenant": "", "id": "i-1" },
          "expect": null
        },
        {
          "search": { "namespace": "incidents", "tenant": "acme", "vector": [1, 0, 0], "model": "m" },
          "expect": [{ "id": "i-1", "similarity": 0 }]
        }
      ]
    },
    {
      "name": "a deleted record is gone",
      "dimensions": 3,
      "steps": [
        {
          "at": "2026-10-01T00:00:00Z",
          "upsert_many": [
            { "namespace": "n", "id": "keep", "embedding": { "model": "m", "vector": [1, 0, 0] } },
            { "namespace": "n", "id": "gone", "embedding": { "model": "m", "vector": [1, 0, 0] } }
          ]
        },
        { "delete": { "namespace": "n", "tenant": "", "id": "gone" }, "expect": true },
        { "delete": { "namespace": "n", "tenant": "", "id": "gone" }, "expect": false },
        { "delete": { "namespace": "n", "tenant": "", "id": "never" }, "expect": false },
        { "get": { "namespace": "n", "tenant": "", "id": "gone" }, "expect": null },
        {
          "search": { "namespace": "n", "vector": [1, 0, 0], "model": "m" },
          "expect": [{ "id": "keep", "similarity": 1 }]
        },
        { "list": { "namespace": "n" }, "expect_pages": [["keep"]] }
      ]
    },
    {
      "name": "a listing goes by id, one tenant at a time, in pages",
      "dimensions": 3,
      "steps": [
        {
          "at": "2026-10-01T00:00:00Z",
          "upsert_many": [
            { "namespace": "runbooks", "id": "restart-pod", "embedding": { "model": "m", "vector": [1, 0, 0] } },
            { "namespace": "runbooks", "id": "add-replica", "embedding": { "model": "m", "vector": [0, 1, 0] } },
            { "namespace": "runbooks", "id": "rollback", "embedding": { "model": "m2", "vector": [0, 0, 1] } },
            { "namespace": "runbooks", "id": "drain-node", "embedding": { "model": "m", "vector": [1, 1, 1] } },
            { "namespace": "runbooks", "id": "flush-cache", "embedding": { "model": "m", "vector": [1, 0, 1] } },
            { "namespace": "runbooks", "tenant": "acme", "id": "acme-only", "embedding": { "model": "m", "vector": [1, 0, 0] } },
            { "namespace": "incidents", "id": "not-a-runbook", "embedding": { "model": "m", "vector": [1, 0, 0] } }
          ]
        },
        {
          "list": { "namespace": "runbooks", "limit": 2 },
          "expect_pages": [["add-replica", "drain-node"], ["flush-cache", "restart-pod"], ["rollback"]]
        },
        {
          "list": { "namespace": "runbooks" },
          "expect_pages": [["add-replica", "drain-node", "flush-cache", "restart-pod", "rollback"]]
        },
        {
          "list": { "namespace": "runbooks", "tenant": "acme" },
          "expect_pages": [["acme-only"]]
        },
        {
          "list": { "namespace": "facts" },
          "expect_pages": [[]]
        }
      ]
    },
    {
      "name": "a purge deletes by age, oldest first, up to its limit, filtered by namespace and tenant",
      "dimensions": 3,
      "steps": [
        { "at": "2026-10-01T00:00:00Z", "upsert": { "namespace": "n", "id": "oldest", "embedding": { "model": "m", "vector": [1, 0, 0] } } },
        { "at": "2026-10-01T00:00:00Z", "upsert": { "namespace": "n", "id": "eldest", "embedding": { "model": "m", "vector": [1, 0, 0] } } },
        { "at": "2026-10-02T00:00:00Z", "upsert": { "namespace": "n", "id": "older", "embedding": { "model": "m", "vector": [1, 0, 0] } } },
        { "at": "2026-10-02T00:00:00Z", "upsert": { "namespace": "n", "tenant": "acme", "id": "acme-old", "embedding": { "model": "m", "vector": [1, 0, 0] } } },
        { "at": "2026-10-02T00:00:00Z", "upsert": { "namespace": "other", "id": "other-old", "embedding": { "model": "m", "vector": [1, 0, 0] } } },
        { "at": "2026-10-03T00:00:00Z", "upsert": { "namespace": "n", "id": "new", "embedding": { "model": "m", "vector": [1, 0, 0] } } },
        { "at": "2026-10-04T00:00:00Z", "upsert": { "namespace": "n", "id": "oldest", "embedding": { "model": "m", "vector": [0, 1, 0] } } },
        { "purge": { "older_than": "2026-10-03T00:00:00Z", "namespace": "n", "tenant": "", "limit": 1 }, "expect": 1 },
        { "get": { "namespace": "n", "tenant": "", "id": "eldest" }, "expect": null },
        { "list": { "namespace": "n" }, "expect_pages": [["new", "older", "oldest"]] },
        { "purge": { "older_than": "2026-10-03T00:00:00Z", "namespace": "n", "tenant": "" }, "expect": 1 },
        { "purge": { "older_than": "2026-10-03T00:00:00Z", "namespace": "n", "tenant": "" }, "expect": 0 },
        { "list": { "namespace": "n" }, "expect_pages": [["new", "oldest"]] },
        { "list": { "namespace": "n", "tenant": "acme" }, "expect_pages": [["acme-old"]] },
        { "purge": { "older_than": "2026-10-03T00:00:00Z", "namespace": "n" }, "expect": 1 },
        { "list": { "namespace": "n", "tenant": "acme" }, "expect_pages": [[]] },
        { "purge": { "older_than": "2026-10-03T00:00:00Z" }, "expect": 1 },
        { "list": { "namespace": "other" }, "expect_pages": [[]] },
        { "purge": { "older_than": "2026-10-04T00:00:00Z" }, "expect": 1 },
        { "list": { "namespace": "n" }, "expect_pages": [["oldest"]] }
      ]
    },
    {
      "name": "bad input is refused before anything is written",
      "dimensions": 3,
      "steps": [
        { "at": "2026-10-01T00:00:00Z", "upsert": { "namespace": "", "id": "a", "embedding": { "model": "m", "vector": [1, 0, 0] } }, "error": "the namespace is empty" },
        { "upsert": { "namespace": "n", "id": "", "embedding": { "model": "m", "vector": [1, 0, 0] } }, "error": "the id is empty" },
        { "upsert": { "namespace": "n", "id": "a", "embedding": { "model": "", "vector": [1, 0, 0] } }, "error": "the model is empty" },
        { "upsert": { "namespace": "n", "id": "a", "embedding": { "model": "m", "vector": [1, 0] } }, "error": "the vector has 2 dimensions, and this store has 3" },
        { "upsert": { "namespace": "n", "id": "a", "embedding": { "model": "m", "vector": [0, 0, 0] } }, "error": "the vector is all zeros" },
        { "upsert": { "namespace": "n", "id": "a", "embedding": { "model": "m", "vector": [1, 0, 0] }, "metadata": { "": "x" } }, "error": "a metadata key is empty" },
        {
          "upsert_many": [
            { "namespace": "n", "id": "good", "embedding": { "model": "m", "vector": [1, 0, 0] } },
            { "namespace": "n", "id": "bad", "embedding": { "model": "m", "vector": [1, 0, 0, 0] } }
          ],
          "error": "the vector has 4 dimensions, and this store has 3"
        },
        { "get": { "namespace": "n", "tenant": "", "id": "good" }, "expect": null },
        { "search": { "namespace": "n", "vector": [1, 0, 0], "model": "m", "limit": 0 }, "error": "the limit is 0; it must be from 1 to 1000" },
        { "search": { "namespace": "n", "vector": [1, 0, 0], "model": "m", "limit": 1001 }, "error": "the limit is 1001; it must be from 1 to 1000" },
        { "search": { "namespace": "n", "vector": [1, 0, 0], "model": "m", "min_similarity": 1.5 }, "error": "the minimum similarity is 1.5; it must be from -1 to 1" },
        { "search": { "namespace": "n", "vector": [0, 0, 0], "model": "m" }, "error": "the vector is all zeros" },
        { "search": { "namespace": "", "vector": [1, 0, 0], "model": "m" }, "error": "the namespace is empty" },
        { "list": { "namespace": "n" }, "expect_pages": [[]] }
      ]
    }
  ]
}
