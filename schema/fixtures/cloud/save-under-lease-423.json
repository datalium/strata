{
  "description": "A save under a lease another owner has replaced: 423 LEASE_LOST is LeaseLost (.NET LeaseLostException), never retried, nothing stored.",
  "operation": "save_under_lease",
  "checkpoint": "../checkpoint-lifecycle/running.json",
  "lease": {
    "thread_id": "thread_running_demo",
    "owner": "worker-1",
    "token": 3,
    "expires_at": "2026-10-20T12:00:30.123Z"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/sdk/checkpoints",
        "query": {},
        "headers": {
          "authorization": "Bearer {api_key}",
          "accept": "application/json",
          "content-type": "application/json",
          "strata-lease-token": "3"
        },
        "absent_headers": [
          "strata-if-sequence",
          "content-encoding"
        ],
        "body": "checkpoint"
      },
      "response": {
        "status": 423,
        "headers": {},
        "body": {
          "status": "FAILED",
          "code": "STRATA_CLOUD_API_LEASE_LOST",
          "error": "The lease's token is not the thread's latest",
          "timestamp": "2026-10-20T12:00:00.000Z",
          "statusCode": 423
        }
      }
    }
  ],
  "expect": {
    "leased_save": "lease_lost"
  }
}
