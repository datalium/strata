        { "path": "Fan/k2/Step", "key": "thread_map_demo/Fan/k2/Step#2.1", "is_recovery": true },
        { "path": "Fan/k2/Then", "key": "thread_map_demo/Fan/k2/Then#2.2", "is_recovery": true },
        { "path": "Done", "key": "thread_map_demo/Done#3", "is_recovery": false }
      ]
    },
